{
  "name": "en-yup-decorator",
  "version": "1.2.0",
  "description": "A TypeScript library for creating yup schema decorators, simplifying schema validations.",
  "keywords": [
    "decorators",
    "schema",
    "typescript",
    "validation",
    "yup",
    "yup-decorators"
  ],
  "homepage": "https://github.com/MattiaPispisa/en-yup-decorator#readme",
  "bugs": {
    "url": "https://github.com/MattiaPispisa/en-yup-decorator/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mattia Pispisa",
    "email": "mattia.pispisa@gmail.com",
    "url": "https://mattiapispisa.it"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MattiaPispisa/en-yup-decorator"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:coverage": "tsdx test --coverage",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "dev": "tsdx dev",
    "build": "tsdx build",
    "test": "tsdx test",
    "test:watch": "tsdx test --watch",
    "lint": "tsdx lint",
    "format": "tsdx format",
    "format:check": "tsdx format --check",
    "typecheck": "tsdx typecheck",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "reflect-metadata": "^0.1.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "husky": "^9.1.7",
    "size-limit": "^11.1.6",
    "tsdx": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0",
    "yup": "^1.0.0"
  },
  "peerDependencies": {
    "yup": "^1.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "size-limit": [
    {
      "path": "dist/en-yup-decorator.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/en-yup-decorator.esm.js",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
